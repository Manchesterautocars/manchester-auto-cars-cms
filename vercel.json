{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    { "src": "api/status.js", "use": "@vercel/node" },
    { "src": "api/cloudinary-sign.js", "use": "@vercel/node" },
    { "src": "api/delete-vehicle-image.js", "use": "@vercel/node" },
    { "src": "api/get-vehicles.js", "use": "@vercel/node" },
    { "src": "api/publish-vehicles.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "assets/**", "use": "@vercel/static" },
    { "src": "data/**", "use": "@vercel/static" }
  ],
  "cleanUrls": false,
  "trailingSlash": false
}
